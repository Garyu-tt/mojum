[Unit]
Description=Cezar Mojum fleet visibility (schedules, active runs, model slots, GitHub artifacts)
After=cezar-mojum-r01.service
Requires=cezar-mojum-r01.service

[Service]
Type=oneshot
User=mirbi
Group=mirbi
ExecStart=/usr/bin/python3 -B /var/lib/cezar/fleet-visibility-r01.py
TimeoutStartSec=35
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/cezar/home/fleet /var/lib/cezar/runtime/node_modules/@open-mercato/cezar/web/dist/assets
InaccessiblePaths=/srv/mirbi /var/lib/cezar/config /var/lib/cezar/migrations
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077
MemoryMax=165M
CPUQuota=65%
TasksMax=32
LimitNOFILE=512

[Install]
WantedBy=multi-user.target
