[Unit]
Description=Mojum Cezar admission reconciliation / fail-closed timed QA cleanup
Wants=network-online.target
After=network-online.target cezar-mojum-r01.service
Requires=cezar-mojum-r01.service
ConditionPathExists=/var/lib/cezar/guarded-intake/cezar_reconcile.py
ConditionPathExists=/var/lib/cezar/home/admission/mojum.sqlite

[Service]
Type=oneshot
User=mirbi
Group=mirbi
WorkingDirectory=/var/lib/cezar/guarded-intake
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 /var/lib/cezar/guarded-intake/cezar_reconcile.py --db /var/lib/cezar/home/admission/mojum.sqlite
TimeoutStartSec=45
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/cezar/home/admission
ProtectHome=true
InaccessiblePaths=/srv/mirbi /var/lib/cezar/config /var/lib/cezar/migrations /var/lib/cezar/home/legacy-index
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077
MemoryMax=200M
CPUQuota=75%
TasksMax=25
LimitNOFILE=512
