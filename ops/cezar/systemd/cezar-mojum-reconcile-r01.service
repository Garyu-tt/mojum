[Unit]
Description=Mojum Cezar admission reconciliation / fail-closed timed QA cleanup
Wants=network-online.target
After=network-online.target cezar-mojum-r01.service
Requires=cezar-mojum-r01.service
ConditionPathExists=/opt/cezar-gate/cezar_reconcile.py
ConditionPathExists=/var/lib/cezar-gate/private/mojum.sqlite

[Service]
Type=oneshot
User=cezar_gate
Group=cezar_gate
WorkingDirectory=/opt/cezar-gate
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 /opt/cezar-gate/cezar_reconcile.py --db /var/lib/cezar-gate/private/mojum.sqlite
TimeoutStartSec=45
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/cezar-gate/private
ProtectHome=true
InaccessiblePaths=/var/lib/cezar /srv/mirbi
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077
MemoryMax=200M
CPUQuota=75%
TasksMax=25
LimitNOFILE=512
