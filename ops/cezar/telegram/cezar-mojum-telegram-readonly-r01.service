[Unit]
Description=Cezar to Telegram private read-only HTTP bridge
After=cezar-mojum-r01.service
Requires=cezar-mojum-r01.service

[Service]
Type=simple
User=mirbi
Group=mirbi
ExecStart=/usr/bin/python3 -B /opt/cezar-telegram-gateway/readonly.py
Restart=always
RestartSec=8
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
InaccessiblePaths=/srv/mirbi /var/lib/cezar/config /var/lib/cezar/migrations
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077
MemoryMax=160M
CPUQuota=50%
TasksMax=32

[Install]
WantedBy=multi-user.target
